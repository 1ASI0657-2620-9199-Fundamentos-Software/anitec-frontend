# Production talks to the API gateway deployed on Azure Container Apps. The gateway sends /subscription-plans and
# /subscriptions to the Subscriptions service and everything else to the core. VITE_* values are embedded at build time,
# so changing the address needs a new build. The gateway only answers the origins listed in its Cors:AllowedOrigins.
VITE_ANITEC_API_URL="https://ca-gateway.ambitiousbeach-b230ce78.eastus2.azurecontainerapps.io/api/v1"
VITE_ANITEC_SERVER_URL="https://ca-gateway.ambitiousbeach-b230ce78.eastus2.azurecontainerapps.io"
VITE_SIGNIN_ENDPOINT_PATH="/authentication/sign-in"
VITE_SIGNUP_ENDPOINT_PATH="/authentication/sign-up"
VITE_USERS_ENDPOINT_PATH="/users"
VITE_HERDS_ENDPOINT_PATH="/herds"
VITE_ANIMALS_ENDPOINT_PATH="/animals"
VITE_CORRALS_ENDPOINT_PATH="/corrals"
VITE_HEALTH_EVENTS_ENDPOINT_PATH="/health-events"
VITE_FINANCIAL_RECORDS_ENDPOINT_PATH="/financial-records"
VITE_FARM_ACTIVITIES_ENDPOINT_PATH="/farm-events"
VITE_ANALYTICS_METRICS_ENDPOINT_PATH="/report-metrics"
VITE_DEVICES_ENDPOINT_PATH="/devices"
VITE_DEVICE_METRICS_ENDPOINT_PATH="/device-metrics"
VITE_SUBSCRIPTION_PLANS_ENDPOINT_PATH="/subscription-plans"